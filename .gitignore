# Dependencies
node_modules/

# Build output
dist/
rust/target/

# Local data & auth
store/
data/
logs/

# Groups - only track base structure and specific CLAUDE.md files
groups/*
!groups/main/
!groups/global/
groups/main/*
groups/global/*
!groups/main/CLAUDE.md
!groups/global/CLAUDE.md

# Secrets
*.keys.json
.env
config/intercom.toml

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/

agents-sdk-docs

# Clavain session artifacts
.clavain/
.clavain/verdicts/
.clavain/**/*.db
.clavain/**/*.db-shm
.clavain/**/*.db-wal

# core.hooksPath points here, so this is where the shared pre-commit secret
# scanner lives -- git machinery, exactly like .git/hooks, which is never
# tracked either. There is no beads in this repo: no config.yaml, no
# issues.jsonl, nothing but the one hook file cloud/install-hooks.sh wrote.
#
# Scoped to hooks/ rather than the whole .beads/ so that if beads is ever
# actually initialised here, its issues.jsonl is not silently ignored.
.beads/hooks/
