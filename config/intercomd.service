[Unit]
Description=Intercom daemon (Telegram polling, orchestration, container dispatch)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/mk/projects/Demarch/apps/Intercom
ExecStart=/home/mk/projects/Demarch/apps/Intercom/go/intercomd serve --config config/intercom.toml
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# Graceful shutdown — give subprocesses time to finish
TimeoutStopSec=30

# Environment overrides (uncomment to customize)
# Environment=INTERCOMD_BIND=127.0.0.1:7340

[Install]
WantedBy=default.target
